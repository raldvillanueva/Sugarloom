# TEMPLATE ONLY — this file IS committed. Never put real values here.
# Copy it to .env (which is gitignored) and fill that in instead:
#     cp .env.example .env
# On a host like Vercel or Render, set these in the dashboard rather than
# in any file.

# Gmail account used to send order emails and OTP codes.
# Must be the full address, e.g. yourname@gmail.com
# EMAIL_PASS is a 16-character Google App Password, not your login password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=

# Google AI Studio key for the chatbot: https://aistudio.google.com/apikey
# Without it the site falls back to the built-in keyword replies.
GEMINI_API_KEY=

# Port to listen on. Hosts usually set this themselves.
PORT=5000
