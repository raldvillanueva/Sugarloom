# TEMPLATE ONLY — this file IS committed. Never put real values here.
# Copy it to .env (which is gitignored) and fill that in instead:
#     cp .env.example .env
# On a host like Vercel or Render, set these in the dashboard rather than
# in any file.

# The address order emails and OTP codes are sent FROM. Must be a sender
# you have verified with the relay below, e.g. yourname@gmail.com
EMAIL_USER=

# The SMTP relay that actually sends. Defaults to Brevo on port 2525.
# Port 2525 matters: Render's free instances block outbound 25, 465 and
# 587, so Gmail's own SMTP cannot be reached from there at all.
# Sign up at https://www.brevo.com, verify EMAIL_USER as a sender, then
# take these from SMTP & API -> SMTP.
#   SMTP_USER is the login Brevo shows you (often your signup email)
#   SMTP_KEY  is the generated SMTP key, NOT your Brevo password
SMTP_USER=
SMTP_KEY=
# Optional - only to point at a relay other than Brevo
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525

# Google AI Studio key for the chatbot: https://aistudio.google.com/apikey
# Without it the site falls back to the built-in keyword replies.
GEMINI_API_KEY=

# ── LALAMOVE ──
# Leave these blank and deliveries are simulated, which is enough to
# demonstrate the whole flow. Fill them in and the server books real
# sandbox deliveries through the Lalamove Partner API v3.
#
# Keys come from https://partnerportal.lalamove.com → Developers tab.
# Sandbox keys look like pk_test_… / sk_test_…
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=

# sandbox (default) or production. Keep it on sandbox — production books
# real couriers and charges a real wallet.
LALAMOVE_ENV=sandbox
LALAMOVE_MARKET=PH
LALAMOVE_SERVICE=MOTORCYCLE

# Where the rider collects. Lalamove works in coordinates, not text
# addresses. Keep these matching BAKERY in js/delivery-fee.js, which is
# what the customer-facing delivery fee is measured from.
LALAMOVE_PICKUP_LAT=14.5572974
LALAMOVE_PICKUP_LNG=121.0909923
LALAMOVE_PICKUP_ADDRESS=Pinagbuhatan, Pasig City
LALAMOVE_PICKUP_NAME=SugarLoom Ph
LALAMOVE_PICKUP_PHONE=+639171234567

# Port to listen on. Hosts usually set this themselves.
PORT=5000
