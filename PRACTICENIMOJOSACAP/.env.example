# Copy this file to .env and fill in real values. .env is gitignored —
# never commit credentials, and never add them as fallbacks in the code.

# Gmail account used to send order emails and OTP codes.
# EMAIL_PASS is a Google App Password (16 characters), not your login password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your.address@gmail.com
EMAIL_PASS=

# Google AI Studio key for the chatbot: https://aistudio.google.com/apikey
# Without it the site falls back to the built-in keyword replies.
GEMINI_API_KEY=

# Port to listen on. Hosts usually set this themselves.
PORT=5000
